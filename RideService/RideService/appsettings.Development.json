{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "taxi-auth-service",
    "Audience": "taxi-client",
    "SecretKey": "dev-super-secret-key"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "RideTopic": "ride",
